{
  "name": "ramen-empire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:all": "bun run typecheck && bun run test:run && bun run test:browser",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "sliver-engine": "0.0.1-alpha-9"
  }
}
